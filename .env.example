# The default static deployment needs NO environment variables.
# These settings are for the optional LOCAL workspace server only.
# Copy to .env when needed. Never commit the resulting .env or real credentials.
# Start with: npm run build:workspace, then npm run dev:workspace
PORT=5173
XEDO_DATA_DIR=data

# Empty token leaves Pi ingestion unconfigured. Configure the same generated
# private token on the server and the physical Pi only when testing that device.
XEDO_PI_DEVICE_ID=pi-001
XEDO_PI_TOKEN=

# Leave empty until the project and service account are authorized for GEE.
# Keep the JSON as one line in the local .env or private server secret store.
# Never add it to browser code, public assets, snapshots, or GitHub.
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_JSON=
# Optional local file instead of inline JSON; inline JSON takes precedence.
# Keep this file private. Relative paths resolve from the project directory.
GEE_SERVICE_ACCOUNT_FILE=secrets/gee-service-account.json
GEE_PROBE_ASSET=

# Read-only Supabase connection diagnostics. These do not replace SQLite/blob
# persistence or create tables, user policies, or storage buckets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
