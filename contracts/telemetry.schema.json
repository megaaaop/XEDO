{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XEDO TelemetryEvent",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "device_id",
    "boot_id",
    "sequence",
    "observed_at",
    "clock_quality",
    "source_mode",
    "position",
    "battery",
    "dispenser",
    "health"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_mode": {
      "enum": [
        "live",
        "simulated",
        "replay"
      ]
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{5,90}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{5,90}$"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{5,90}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "clock_quality": {
      "enum": [
        "synced",
        "unsynced",
        "simulation_clock",
        "unknown"
      ]
    },
    "mission_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "position": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "longitude",
        "latitude",
        "valid"
      ],
      "properties": {
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -85,
          "maximum": 85
        },
        "valid": {
          "type": "boolean"
        },
        "altitude_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -500,
          "maximum": 10000
        },
        "altitude_reference": {
          "enum": [
            "AGL",
            "MSL",
            "ellipsoid",
            "unknown"
          ]
        }
      }
    },
    "battery": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "voltage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "dispenser": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "idle",
            "running",
            "fault",
            "unknown"
          ]
        },
        "requested_setting": {
          "type": [
            "object",
            "null"
          ]
        },
        "measured_rate_kg_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "measured_remaining_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "measured_released_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "health": {
      "type": "object",
      "required": [
        "agent"
      ],
      "properties": {
        "agent": {
          "enum": [
            "online",
            "disconnected",
            "unknown"
          ]
        },
        "fault_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}