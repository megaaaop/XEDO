{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XEDO ProcessingResult input",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "capture_id",
    "status",
    "coordinate_space",
    "processed_at",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{5,90}$"
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{5,90}$"
    },
    "status": {
      "enum": [
        "completed",
        "unavailable",
        "failed"
      ]
    },
    "coordinate_space": {
      "enum": [
        "pixel",
        "none"
      ]
    },
    "algorithm_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "parameters": {
      "type": "object"
    },
    "bboxes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}