{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XEDO Capture metadata input",
  "description": "JSON metadata field in a multipart/form-data upload with the original image file. Live captured_live uploads require the configured device token in addition to the Sites access boundary. Imported uploads use workspace access. Runtime validates referenced incident/device/mission and matching source modes.",
  "type": "object",
  "required": [
    "schema_version",
    "capture_id",
    "device_id",
    "incident_id",
    "source_mode",
    "capture_mode",
    "captured_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_mode": {
      "enum": [
        "live",
        "simulated"
      ]
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{5,90}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{5,90}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{5,90}$"
    },
    "mission_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "capture_mode": {
      "enum": [
        "imported",
        "captured_live"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "width": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 20000,
      "description": "Optional; omitted or null means unknown. Runtime accepts finite numeric dimensions. Completed processing later requires known width and height."
    },
    "height": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 20000,
      "description": "Optional; omitted or null means unknown. Runtime accepts finite numeric dimensions. Completed processing later requires known width and height."
    },
    "camera_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "position": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -85,
          "maximum": 85
        }
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capture_mode": {
            "const": "captured_live"
          }
        },
        "required": [
          "capture_mode"
        ]
      },
      "then": {
        "properties": {
          "source_mode": {
            "const": "live"
          }
        }
      }
    }
  ]
}