# Set the same generated token in the server/Sites settings and here.
XEDO_API_URL=https://YOUR-WORKSPACE-API.example
XEDO_PI_DEVICE_ID=pi-001
XEDO_PI_TOKEN=REPLACE_WITH_GENERATED_TOKEN
# Private Sites also require owner-authorized platform service access.
XEDO_SITE_ACCESS_TOKEN=
XEDO_PI_INTERVAL_S=2
XEDO_PI_STATUS_MAX_AGE_S=10
XEDO_PI_CLOCK_QUALITY=unknown
XEDO_PI_SPOOL=/var/lib/xedo-pi/spool
# Leave empty until a real sensor/flight-controller adapter writes this file.
XEDO_PI_STATUS_JSON=
XEDO_PI_MISSION=
