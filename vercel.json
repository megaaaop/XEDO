{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/inspector.mjs": {
      "maxDuration": 30,
      "includeFiles": "contracts/*.schema.json"
    },
    "api/gee.mjs": {
      "maxDuration": 60
    },
    "api/environment.mjs": {
      "maxDuration": 60
    },
    "api/planning-context.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/inspector/:path*",
      "destination": "/api/inspector?route=:path*"
    },
    {
      "destination": "/api/planning-context",
      "source": "/api/v1/gee/planning-context"
    },
    {
      "source": "/api/v1/environment",
      "destination": "/api/environment"
    },
    {
      "source": "/api/v1/gee/imagery/:path*",
      "destination": "/api/gee?route=:path*"
    }
  ],
  "redirects": [
    {
      "source": "/planning",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/planning.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
