{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/:file(chunk-573ZMPLT\\.js|chunk-5TBO732O\\.js|chunk-77GT6W5N\\.js|chunk-DXM5HYT5\\.js|chunk-GJTFWWDG\\.js|chunk-W5KNTEOZ\\.js|chunk-YSFOXSMF\\.js|coastal-mangrove-bg-5LQHSPNA\\.jpg|deflate-HFSYZTPS\\.js|deployment-3d-5PYMKZLF\\.js|favicon-xedo-planning-8af77f368cd1\\.png|jpeg-IRWWL5ZF\\.js|lerc-S4MXYGDP\\.js|lzw-EHQHNZB6\\.js|packbits-PQSBS4GQ\\.js|planner-24WC4KRG\\.js|planner-LV4OQQA6\\.css|planning-file-api-JG7SLD7Z\\.js|raster-cog-WNRPL6WZ\\.js|raw-OK63VTT6\\.js|sentinel-proof-06ca9f8eac21\\.png|webimage-DLGKDXZD\\.js|xedo-brand-mangrove-web-bdcbbf413bde\\.png|zstd-JFJYRN7P\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/inspector.mjs": {
      "maxDuration": 30,
      "includeFiles": "contracts/*.schema.json"
    },
    "api/gee.mjs": {
      "maxDuration": 60
    },
    "api/environment.mjs": {
      "maxDuration": 60
    },
    "api/planning-context.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/inspector/:path*",
      "destination": "/api/inspector?route=:path*"
    },
    {
      "destination": "/api/planning-context",
      "source": "/api/v1/gee/planning-context"
    },
    {
      "source": "/api/v1/environment",
      "destination": "/api/environment"
    },
    {
      "source": "/api/v1/gee/imagery/:path*",
      "destination": "/api/gee?route=:path*"
    }
  ],
  "redirects": [
    {
      "source": "/planning",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/planning.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
