{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XEDO planning trial source",
  "type": "object",
  "required": [
    "geometry",
    "surveyId",
    "kind"
  ],
  "properties": {
    "geometry": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "maxItems": 121,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -85,
                      "maximum": 85
                    }
                  ],
                  "items": false
                }
              }
            }
          },
          "description": "A closed simple WGS84 ring with 3–120 vertices and no holes. Runtime validates closure, self-intersection, area and the trial latitude/date-line limits."
        },
        {
          "type": "null"
        }
      ]
    },
    "surveyId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{5,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "frozen_survey_snapshot",
        "user_trial_boundary"
      ]
    },
    "incidentId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{5,80}$"
    },
    "sceneId": {
      "type": "string"
    },
    "acquiredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "frozen_survey_snapshot"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "incidentId"
        ],
        "properties": {
          "surveyId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{5,80}$"
          },
          "geometry": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "properties": {
              "type": {
                "const": "Polygon"
              },
              "coordinates": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 121,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      {
                        "type": "number",
                        "minimum": -85,
                        "maximum": 85
                      }
                    ],
                    "items": false
                  }
                }
              }
            },
            "description": "A closed simple WGS84 ring with 3–120 vertices and no holes. Runtime validates closure, self-intersection, area and the trial latitude/date-line limits."
          }
        }
      },
      "else": {
        "properties": {
          "surveyId": {
            "const": null
          }
        }
      }
    }
  ],
  "description": "Frozen Quick mission snapshot or independent trial input. No record is changed. Scene/time fields are retained when present in the saved snapshot."
}